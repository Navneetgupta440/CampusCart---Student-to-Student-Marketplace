# GEMINI_API_KEY: Required for live Gemini AI API calls (Listing Assistant, Category Suggestion, Quality Audit).
# In Google AI Studio, this is automatically injected at runtime from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"
